// Windows resources for leapemu.exe: the icon and version information
// (configured by CMakeLists.txt).
#include <winver.h>

1 ICON "@PROJECT_SOURCE_DIR@/res/leapemu.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "leapemu, an emulator for the LeapFrog Leapster"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "ProductName", "leapemu"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
      VALUE "LegalCopyright", "GNU General Public License v3 or later"
      VALUE "OriginalFilename", "leapemu.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
